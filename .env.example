# ============================================================================
# Residential Emergency Health Response Platform — environment template
# Copy to .env and fill values. NEVER commit a real .env.
# Documented in docs/setup.md. Secrets are supplied per-slice (see PLAN.md).
#
# NOTE: Docker Compose env_file does NOT strip inline "# comments" — they would
# become part of the value. Every comment below is therefore on its own line.
# ============================================================================

# --- Core ---
# APP_ENV: local | staging | prod
APP_ENV=local
APP_NAME=med-emergency-backend
# LOG_LEVEL: structured JSON logs; never log PHI
LOG_LEVEL=INFO

# --- Database (Postgres 15+; docker-compose provides this in local) ---
POSTGRES_USER=medapp
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=medapp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://medapp:change-me-local-only@localhost:5432/medapp

# --- Auth / JWT (short-lived access + refresh; RBAC) ---
JWT_SECRET=change-me-generate-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600
# TRUST_FORWARDED_FOR: set true ONLY when behind a trusted reverse proxy.
# When false, the audited source IP uses the socket peer (not spoofable).
TRUST_FORWARDED_FOR=false

# --- Provider mode: swappable gateways (see PLAN.md "Provider abstraction") ---
# stub -> console + DB logging, zero external deps (dev/CI default)
# live -> real Twilio / FCM / S3 (supply keys below per-slice)
PROVIDER_MODE=stub

# --- Twilio (SMS + voice) — Slice 6+. Leave blank in stub mode ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_VOICE_FROM=

# --- Firebase Cloud Messaging (push) — Slice 5+. Leave blank in stub mode ---
# Path to the service-account JSON (gitignored; never commit the file).
FCM_SERVICE_ACCOUNT_FILE=

# --- Object storage — Slice 4+. LocalStack in local; real S3 + KMS later ---
# S3_ENDPOINT_URL: LocalStack endpoint; leave blank/unset for real AWS
S3_ENDPOINT_URL=http://localhost:4566
S3_BUCKET=med-records-local
S3_REGION=ap-south-1
# S3_SIGNED_URL_TTL_SECONDS: hard cap is 900 (15 minutes)
S3_SIGNED_URL_TTL_SECONDS=900
# AWS_* below are LocalStack dummy creds in local
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# S3_KMS_KEY_ID: set for real AWS (SSE-KMS); leave bare/empty in local
S3_KMS_KEY_ID=

# --- Email (Mailhog in local; real SMTP later) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@med-emergency.local

# --- Emergency policy ---
# Technical defaults; ops decisions tracked in docs/open-questions.md
# under [NEEDS_OPS_DECISION].
# EMERGENCY_ACK_TIMEOUT_SECONDS: no-ack -> backup escalation + fallback UX
EMERGENCY_ACK_TIMEOUT_SECONDS=60
# NATIONAL_EMERGENCY_NUMBERS: the ONLY hardcoded fallback numbers
NATIONAL_EMERGENCY_NUMBERS=108,112
