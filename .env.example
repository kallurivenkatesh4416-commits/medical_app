# ============================================================================
# Residential Emergency Health Response Platform — environment template
# Copy to .env and fill values. NEVER commit a real .env.
# Documented in docs/setup.md. Secrets are supplied per-slice (see PLAN.md).
#
# NOTE: Docker Compose env_file does NOT strip inline "# comments" — they would
# become part of the value. Every comment below is therefore on its own line.
# ============================================================================

# --- Core ---
# APP_ENV: local | staging | prod
APP_ENV=local
APP_NAME=med-emergency-backend
# LOG_LEVEL: structured JSON logs; never log PHI
LOG_LEVEL=INFO

# --- Database (Postgres 15+; docker-compose provides this in local) ---
POSTGRES_USER=medapp
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=medapp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://medapp:change-me-local-only@localhost:5432/medapp

# --- Auth / JWT (short-lived access + refresh; RBAC) ---
JWT_SECRET=change-me-generate-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600
# TRUST_FORWARDED_FOR: set true ONLY when behind a trusted reverse proxy.
# When false, the audited source IP uses the socket peer (not spoofable).
TRUST_FORWARDED_FOR=false

# --- Provider mode: swappable gateways (see PLAN.md "Provider abstraction") ---
# stub -> console + DB logging, zero external deps (dev/CI default)
# live -> real Twilio / FCM / S3 (supply keys below per-slice)
PROVIDER_MODE=stub

# --- Twilio (SMS + voice + WhatsApp) — Slice 6 / 8. Leave blank in stub mode ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_VOICE_FROM=
# TWILIO_WHATSAPP_FROM: Twilio WhatsApp sender (e.g. whatsapp:+14155238886).
# Required for Slice 8 handover WhatsApp dispatch in PROVIDER_MODE=live.
# Without this, handover_dispatches rows for the whatsapp channel will land
# in failed status with error "RuntimeError" (no sender configured).
TWILIO_WHATSAPP_FROM=
# TWILIO_STATUS_CALLBACK_URL: Slice 16 — Twilio posts SMS/voice delivery
# state to this URL. Must be publicly reachable AND HTTPS in production.
# The handler validates X-Twilio-Signature with the auth token above.
# Leave blank to disable callbacks (the synchronous "sent" status is then
# the only signal). Example: https://api.example.com/api/v1/notifications/twilio/status
TWILIO_STATUS_CALLBACK_URL=

# --- Firebase Cloud Messaging (push) — Slice 5+. Leave blank in stub mode ---
# Path to the service-account JSON (gitignored; never commit the file).
FCM_SERVICE_ACCOUNT_FILE=
# FCM_PROJECT_ID: Slice 16 — GCP project id for the FCM HTTP v1 send URL.
# Required in PROVIDER_MODE=live for push. The service account file knows
# its own project, but the FCM endpoint path needs the project named too.
FCM_PROJECT_ID=

# --- Object storage — Slice 4+. LocalStack in local; real S3 + KMS later ---
# S3_ENDPOINT_URL: LocalStack endpoint; leave blank/unset for real AWS
S3_ENDPOINT_URL=http://localhost:4566
S3_BUCKET=med-records-local
S3_REGION=ap-south-1
# S3_SIGNED_URL_TTL_SECONDS: hard cap is 900 (15 minutes)
S3_SIGNED_URL_TTL_SECONDS=900
# LOCAL_STORAGE_DIR: encrypted local stub object store used when PROVIDER_MODE=stub
LOCAL_STORAGE_DIR=./var/records
# PUBLIC_BASE_URL: used to form local stub signed download links
PUBLIC_BASE_URL=http://localhost:8000
# MAX_UPLOAD_BYTES: default 15 MiB
MAX_UPLOAD_BYTES=15728640
# AWS_* below are LocalStack dummy creds in local
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# S3_KMS_KEY_ID: set for real AWS (SSE-KMS); leave bare/empty in local
S3_KMS_KEY_ID=

# --- Email (Mailhog in local; real SMTP later) ---
# Slice 8 hospital handover dispatch routes through SmtpEmailGateway in
# PROVIDER_MODE=live; Mailhog needs no auth/TLS in dev.
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USERNAME / SMTP_PASSWORD: required by SES / Mailgun / Postfix-auth in
# prod; leave blank for Mailhog.
SMTP_USERNAME=
SMTP_PASSWORD=
# SMTP_USE_TLS: STARTTLS for prod SMTP; false for Mailhog.
SMTP_USE_TLS=false
# HANDOVER_EMAIL_FROM: the From: address on outbound handover emails.
HANDOVER_EMAIL_FROM=handover@med-emergency.local
# HANDOVER_EMAIL_SUBJECT_PREFIX: prepended to the Subject; the hospital
# destination is appended automatically at dispatch time.
HANDOVER_EMAIL_SUBJECT_PREFIX=Hospital handover

# --- Emergency policy ---
# Technical defaults; ops decisions tracked in docs/open-questions.md
# under [NEEDS_OPS_DECISION].
# EMERGENCY_ACK_TIMEOUT_SECONDS: no-ack -> backup escalation + fallback UX
EMERGENCY_ACK_TIMEOUT_SECONDS=60
# NOTIFICATION_STUCK_CLAIM_SECONDS: re-queue notification_attempts that stayed
# in sending after a provider-process crash for at least this many seconds.
NOTIFICATION_STUCK_CLAIM_SECONDS=300
# NATIONAL_EMERGENCY_NUMBERS: the ONLY hardcoded fallback numbers
NATIONAL_EMERGENCY_NUMBERS=108,112
# SCHEDULER_TICK_SECONDS: Slice 17 — how often the runner checks for
# alerts that need backup escalation + notification attempts stuck in
# `sending`. Worst-case backup paging time is
# EMERGENCY_ACK_TIMEOUT_SECONDS + SCHEDULER_TICK_SECONDS. Both jobs are
# idempotent so over-firing is safe.
SCHEDULER_TICK_SECONDS=5
# DASHBOARD_ORIGINS: Slice 15 — comma-separated CORS allowlist for the
# Vite dashboard. Local default targets Vite's dev port. Production
# should set this to the deployed dashboard host (no trailing slash).
# Leave empty to mount no CORS middleware at all.
DASHBOARD_ORIGINS=http://localhost:5173
